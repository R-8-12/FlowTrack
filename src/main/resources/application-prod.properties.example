# Production profile template for deployment.
# Copy to application-prod.properties only if your deployment process uses files.
# Recommended: keep secrets in platform secret stores / environment variables.

# Activate in production with SPRING_PROFILES_ACTIVE=prod

# Database
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/ims?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false}
spring.datasource.username=${DB_USERNAME:}
spring.datasource.password=${DB_PASSWORD:}

# Server
server.port=${PORT:8080}

# Mail
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
mail.from.email=${MAIL_FROM_EMAIL:}

# External APIs / payments
gemini.api.key=${GEMINI_API_KEY:}
razorpay.key.id=${RAZORPAY_KEY_ID:}
razorpay.key.secret=${RAZORPAY_KEY_SECRET:}
razorpay.webhook.secret=${RAZORPAY_WEBHOOK_SECRET:}

# Google OAuth2
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:}
spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/{registrationId}

# Recommended production toggles
spring.thymeleaf.cache=true
logging.level.org.hibernate.SQL=INFO